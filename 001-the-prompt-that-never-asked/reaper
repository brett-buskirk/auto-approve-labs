#!/usr/bin/env bash
# reaper — lab companion for Auto-Approve episode 001, "The Prompt That Never Asked".
# A minimal stale-branch reaper with the same safety spine as the real tool it re-derives
# (freki): dry-run by default, --apply required to mutate, a confirm gate that reads from
# the terminal, and an append-only audit log.
#
#   ./reaper <fixture-repo> [--apply] [--yes]
#
# Lab flags (env):
#   REAPER_BUGGY_TTY_PROBE=1  use the buggy tty probe the episode studies (permission-bits
#                             check instead of an actual open)
#   REAPER_NO_STRICT=1        turn off `set -u`, to show what the buggy probe does when
#                             strict mode isn't there to crash it (spoiler: default-No)

# Matches the source tool: -u so an unset variable is fatal (that fatality is the episode's
# second act), no -e — errors are handled explicitly.
set -uo pipefail
[ "${REAPER_NO_STRICT:-0}" = 1 ] && set +u

SELF="$(readlink -f "$0" 2>/dev/null || echo "$0")"; HERE="$(cd "$(dirname "$SELF")" && pwd)"
LOG="${REAPER_LOG:-$HERE/state/reaped.log}"
APPLY=0; YES=0; REPO=""

usage(){ printf 'usage: reaper <fixture-repo> [--apply] [--yes]\n' >&2; exit 2; }

for arg in "$@"; do
  case "$arg" in
    --apply) APPLY=1;;
    --yes)   YES=1;;
    -*)      usage;;
    *)       [ -n "$REPO" ] && usage; REPO="$arg";;
  esac
done
[ -n "$REPO" ] && [ -d "$REPO/.git" ] || usage

# Blast-radius guard for the lab harness: this tool deletes branches, so it refuses to run
# anywhere except the disposable fixture `make setup` creates. Bounding the blast radius
# before the interesting bugs get a vote is the whole posture the episode teaches.
if [ ! -f "$REPO/.reaper-lab-fixture" ]; then
  printf 'refusing: %s is not the lab fixture (no .reaper-lab-fixture marker).\n' "$REPO" >&2
  printf 'this tool deletes branches; it only runs on the fixture "make setup" creates.\n' >&2
  exit 3
fi

would(){ printf '  [dry-run] would %s\n' "$1"; }

confirm(){  # $1 = prompt; 0 = go, 1 = abort. Reads /dev/tty so piped stdin can't skip it.
  [ "$YES" = 1 ] && return 0

  if [ "${REAPER_BUGGY_TTY_PROBE:-0}" = 1 ]; then
    # THE BUG UNDER STUDY. `[ -r /dev/tty ]` only checks permission bits, and /dev/tty's
    # mode satisfies them even when this process has no controlling terminal (cron, CI,
    # setsid, an agent). The probe passes, both redirects below then fail to open, `reply`
    # is never set, and `set -u` kills the script at the case expansion with a raw
    # `unbound variable` — instead of the documented refusal. With REAPER_NO_STRICT=1 the
    # expansion yields an empty string and the [y/N] default-No branch refuses by accident.
    if [ ! -r /dev/tty ]; then
      printf 'no tty for confirmation — pass --yes to proceed non-interactively.\n' >&2
      return 1
    fi
    local reply
    printf '%s [y/N] ' "$1" > /dev/tty
    read -r reply < /dev/tty
    case "$reply" in y|Y|yes|YES) return 0;; *) return 1;; esac
  fi

  # THE FIX. Permission bits can't detect a missing controlling terminal; actually opening
  # /dev/tty can. The stderr dance matters: `exec`'s redirections have no subprocess to
  # scope to, so tacking a blanket silence onto the exec itself would mute this shell's
  # stderr for good on the success path. Save it, probe, restore it.
  exec 6>&2 2>/dev/null; exec 3<>/dev/tty; local rc=$?; exec 2>&6 6>&-
  if [ "$rc" != 0 ]; then
    printf 'no tty for confirmation — pass --yes to proceed non-interactively.\n' >&2
    return 1
  fi
  local reply
  printf '%s [y/N] ' "$1" >&3
  read -r reply <&3
  exec 3<&-
  case "$reply" in y|Y|yes|YES) return 0;; *) return 1;; esac
}

log_action(){  # $1 = description of what was deleted
  mkdir -p "$(dirname "$LOG")"
  printf '%s\t%s\t%s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$REPO" "$1" >> "$LOG"
}

do_it(){  # $1 = description; $2.. = the actual delete command
  local desc="$1"; shift
  if [ "$APPLY" != 1 ]; then would "delete $desc"; return 0; fi
  if ! confirm "delete $desc?"; then printf '  skipped %s\n' "$desc"; return 1; fi
  if "$@"; then printf '  deleted %s\n' "$desc"; log_action "$desc"; return 0
  else printf '  failed %s\n' "$desc"; return 1; fi
}

current="$(git -C "$REPO" branch --show-current)"
mapfile -t merged < <(git -C "$REPO" branch --format='%(refname:short)' --merged main)

swept=0
for b in "${merged[@]}"; do
  [ "$b" = main ] && continue
  [ "$b" = "$current" ] && continue
  # `branch -d` (not -D): even past every gate above, git itself still refuses an unmerged
  # branch. One more layer that costs nothing.
  do_it "branch $b (merged into main)" git -C "$REPO" branch -q -d "$b" || true
  swept=$((swept+1))
done

[ "$swept" = 0 ] && printf 'nothing to reap — no merged branches besides main.\n'
[ "$APPLY" != 1 ] && [ "$swept" != 0 ] && printf 'dry-run only. pass --apply to delete.\n'
exit 0
